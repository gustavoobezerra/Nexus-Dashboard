# =====================================================================
# NEXUS DASHBOARD - .gitignore
# =====================================================================
# Arquivos e pastas que NÃO devem ser versionados no Git

# Ambientes virtuais Python
venv/
venv-novo/
env/
ENV/
.venv/

# Arquivos de ambiente - CRÍTICO: NUNCA VERSIONAR!
.env
.env.local
.env.*.local
.env.production
.env.development
*.env

# Segurança - NUNCA versionar chaves ou credenciais
*_key.txt
*_secret.txt
credentials.json
api_keys.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporários
*.tmp
*.temp
*.bak
*.backup

# Node modules (se usar Node.js)
node_modules/

# Scripts de instalação
get-pip.py
INSTALAR-DEPENDENCIAS.bat

# Arquivos grandes desnecessários
*.zip
*.tar.gz
*.rar

# Cache
.cache/
*.cache

# Sistema operacional
Thumbs.db
Desktop.ini
